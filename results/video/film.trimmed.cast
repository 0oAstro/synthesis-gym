b[38;2;118;118;118m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u001b[0m  \u001b[37m62% [56%, 69%]\u001b[0m                                                    \r\n                 \u001b[37m  Claude Opus 5.5\u001b[0m  \u001b[37m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u001b[0m  \u001b[37m83% [77%, 88%]\u001b[0m                                                    \r\n                                                                                                                                                      \r\n                 \u001b[1;37mFurnace temperature error vs the published recipe (lower is better)\u001b[0m                                                                  \r\n                 \u001b[38;2;74;158;255m  SmolLM3-3B base\u001b[0m  \u001b[38;2;74;158;255m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u001b[0m  \u001b[37m266 \u00b0C\u001b[0m                                                            \r\n                 \u001b[1;38;2;182;255;60mSmolLM3-3B + GRPO\u001b[0m  \u001b[1;38;2;182;255;60m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u001b[0m  \u001b[37m242 \u00b0C\u001b[0m                                                            \r\n                 \u001b[38;2;74;158;255m    Qwen3-4B base\u001b[0m  \u001b[38;2;74;158;255m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u001b[0m  \u001b[37m301 \u00b0C\u001b[0m                                                            \r\n                 \u001b[1;38;2;182;255;60m  Qwen3-4B + GRPO\u001b[0m  \u001b[1;38;2;182;255;60m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u001b[0m  \u001b[37m222 \u00b0C\u001b[0m                                                            \r\n                 \u001b[38;2;118;118;118m        heuristic\u001b[0m  \u001b[38;2;118;118;118m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u001b[0m  \u001b[37m202 \u00b0C\u001b[0m                                                            \r\n                 \u001b[37m  Claude Opus 5.5\u001b[0m  \u001b[37m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u001b[0m  \u001b[37m139 \u00b0C\u001b[0m                                                            \r\n                                                                                                                                                      \r\n                 \u001b[38;2;182;255;60mSmolLM3-3B after 30 GRPO steps: success 8% \u2192 76% (paired p < 1e-40). Part of that is learning to use the tools;\u001b[0m                      \r\n                 \u001b[38;2;182;255;60mits precursor choice also moved toward the literature (11% \u2192 44% exact match). Qwen3-4B: 74% \u2192 76%, not significant.\u001b[0m                 \r\n                 \u001b[2mClosed loop: agents see only paid, noisy XRD. Held-out chemical systems. Simulated outcomes.\u001b[0m                                         "]
